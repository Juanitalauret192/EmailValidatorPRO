<Window x:Class="EmailValidatorPRO.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:EmailValidatorPRO"
        Title="Email Validator PRO v1.1" Height="850" Width="1150"
        MinWidth="950" MinHeight="700"
        Background="{DynamicResource BgPrimary}"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        Icon="evpro.ico">

    <Window.Resources>
        <SolidColorBrush x:Key="BgPrimary" Color="#0D1117"/>
        <SolidColorBrush x:Key="BgSecondary" Color="#161B22"/>
        <SolidColorBrush x:Key="BgTertiary" Color="#21262D"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#30363D"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#C9D1D9"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#8B949E"/>
        <SolidColorBrush x:Key="AccentGreen" Color="#238636"/>
        <SolidColorBrush x:Key="AccentRed" Color="#DA3633"/>
        <SolidColorBrush x:Key="AccentOrange" Color="#D29922"/>
        <SolidColorBrush x:Key="AccentBlue" Color="#58A6FF"/>
        <SolidColorBrush x:Key="AccentPurple" Color="#BC8CFF"/>
        <SolidColorBrush x:Key="ButtonBg" Color="#21262D"/>
        <SolidColorBrush x:Key="ButtonHover" Color="#30363D"/>

        <Style TargetType="Button" x:Key="PrimaryBtn">
            <Setter Property="Background" Value="{DynamicResource AccentGreen}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style TargetType="Button" x:Key="SecondaryBtn">
            <Setter Property="Background" Value="{DynamicResource ButtonBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style TargetType="Button" x:Key="DangerBtn" BasedOn="{StaticResource SecondaryBtn}">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentRed}"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource BgSecondary}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        </Style>

        <Style TargetType="TabControl">
            <Setter Property="Background" Value="{DynamicResource BgSecondary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Background" Value="{DynamicResource BgTertiary}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border Name="TabBorder" Background="{TemplateBinding Background}"
                                CornerRadius="6,6,0,0" Padding="{TemplateBinding Padding}"
                                BorderThickness="1,1,1,0"
                                BorderBrush="{DynamicResource BorderBrush}">
                            <ContentPresenter x:Name="ContentSite"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              ContentSource="Header"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background"
                                        Value="{DynamicResource BgSecondary}"/>
                                <Setter Property="Foreground"
                                        Value="{DynamicResource TextPrimary}"/>
                                <Setter TargetName="TabBorder" Property="BorderBrush"
                                        Value="{DynamicResource AccentBlue}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background"
                                        Value="{DynamicResource ButtonHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER + VELOCIDAD -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Email Validator PRO"
                           FontSize="24" FontWeight="Bold"
                           Foreground="White" Cursor="Hand"
                           Background="Transparent">
                    <TextBlock.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="🔑 Activar Licencia"
                                      Click="Header_ActivateLicense"/>
                        </ContextMenu>
                    </TextBlock.ContextMenu>
                </TextBlock>
                <TextBlock Text="Catch-all detection + Role-based + Scoring + SMTP real"
                           FontSize="11"
                           Foreground="{DynamicResource TextSecondary}"
                           Margin="0,2,0,0"/>
                <TextBlock Text="Dev. Pablo Diez"
                           FontSize="12"
                           Foreground="#8B949E"
                           Margin="0,2,0,0"/>
            </StackPanel>
            <Border Grid.Column="1" Background="{DynamicResource BgSecondary}"
                    CornerRadius="8" Padding="16,8"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="VELOCIDAD" FontSize="10"
                               Foreground="{DynamicResource TextSecondary}"
                               FontWeight="Medium" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding EmailsPerSecond}" FontSize="22"
                               FontWeight="Bold"
                               Foreground="{DynamicResource AccentBlue}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="emails/sec" FontSize="10"
                               Foreground="{DynamicResource TextSecondary}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding TotalTime}" FontSize="12"
                               Foreground="{DynamicResource TextSecondary}"
                               HorizontalAlignment="Center" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- STATS CARDS -->
        <UniformGrid Grid.Row="1" Columns="6" Margin="0,0,0,12" Height="68">
            <Border Background="{DynamicResource BgSecondary}" CornerRadius="8"
                    Padding="12" Margin="3,0"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="TOTAL" FontSize="10"
                               Foreground="{DynamicResource TextSecondary}" FontWeight="Medium"/>
                    <TextBlock Text="{Binding TotalCount, StringFormat='{}{0:N0}'}"
                               FontSize="20" FontWeight="Bold" Foreground="White"/>
                </StackPanel>
            </Border>
            <Border Background="{DynamicResource BgSecondary}" CornerRadius="8"
                    Padding="12" Margin="3,0"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="VÁLIDOS" FontSize="10"
                               Foreground="{DynamicResource AccentGreen}" FontWeight="Medium"/>
                    <TextBlock Text="{Binding ValidCount, StringFormat='{}{0:N0}'}"
                               FontSize="20" FontWeight="Bold"
                               Foreground="{DynamicResource AccentGreen}"/>
                </StackPanel>
            </Border>
            <Border Background="{DynamicResource BgSecondary}" CornerRadius="8"
                    Padding="12" Margin="3,0"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="INVÁLIDOS" FontSize="10"
                               Foreground="{DynamicResource AccentRed}" FontWeight="Medium"/>
                    <TextBlock Text="{Binding InvalidCount, StringFormat='{}{0:N0}'}"
                               FontSize="20" FontWeight="Bold"
                               Foreground="{DynamicResource AccentRed}"/>
                </StackPanel>
            </Border>
            <Border Background="{DynamicResource BgSecondary}" CornerRadius="8"
                    Padding="12" Margin="3,0"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="RISKY" FontSize="10"
                               Foreground="{DynamicResource AccentOrange}" FontWeight="Medium"/>
                    <TextBlock Text="{Binding RiskyCount, StringFormat='{}{0:N0}'}"
                               FontSize="20" FontWeight="Bold"
                               Foreground="{DynamicResource AccentOrange}"/>
                </StackPanel>
            </Border>
            <Border Background="{DynamicResource BgSecondary}" CornerRadius="8"
                    Padding="12" Margin="3,0"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="DESECHABLES" FontSize="10"
                               Foreground="{DynamicResource AccentPurple}" FontWeight="Medium"/>
                    <TextBlock Text="{Binding DisposableCount, StringFormat='{}{0:N0}'}"
                               FontSize="20" FontWeight="Bold"
                               Foreground="{DynamicResource AccentPurple}"/>
                </StackPanel>
            </Border>
            <Border Background="{DynamicResource BgSecondary}" CornerRadius="8"
                    Padding="12" Margin="3,0"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="BLOQUEADOS" FontSize="10"
                               Foreground="#FF7B72" FontWeight="Medium"/>
                    <TextBlock Text="{Binding BlockedCount, StringFormat='{}{0:N0}'}"
                               FontSize="20" FontWeight="Bold" Foreground="#FF7B72"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- CONFIGURACIÓN -->
        <Grid Grid.Row="2" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,16,0">
                <TextBlock Text="Hilos SMTP:" Foreground="{DynamicResource TextSecondary}"
                           FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox ItemsSource="{Binding ThreadOptions}"
                          SelectedItem="{Binding SelectedThreads}"
                          Width="60" FontSize="12" Padding="4"/>
            </StackPanel>
            <CheckBox Grid.Column="1" Content="Verificación SMTP"
                      IsChecked="{Binding EnableSmtp}"
                      Foreground="{DynamicResource TextPrimary}"
                      FontSize="12" VerticalAlignment="Center" Margin="0,0,16,0"/>
            <CheckBox Grid.Column="2" Content="Solo Sintaxis"
                      IsChecked="{Binding SyntaxOnly}"
                      Foreground="{DynamicResource TextPrimary}"
                      FontSize="12" VerticalAlignment="Center" Margin="0,0,16,0"/>
            <CheckBox Grid.Column="3" Content="Catch-all Detection"
                      IsChecked="{Binding EnableCatchAll}"
                      Foreground="{DynamicResource TextPrimary}"
                      FontSize="12" VerticalAlignment="Center" Margin="0,0,16,0"/>
            <TextBlock Grid.Column="4" Foreground="#484F58" FontSize="11"
                       VerticalAlignment="Center"/>
        </Grid>

        <!-- INPUT -->
        <Grid Grid.Row="3" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="EmailInput"
                     Text="{Binding EmailInput, UpdateSourceTrigger=PropertyChanged}"
                     AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                     TextWrapping="Wrap" Height="100"
                     FontFamily="Consolas" FontSize="13"
                     VerticalContentAlignment="Top"/>
            <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Stretch">
                <Button Content="✅ Validar" Command="{Binding ValidateCommand}"
                        Style="{StaticResource PrimaryBtn}"
                        Height="46" Margin="0,0,0,6"/>
                <Button Content="⏹ Detener" Command="{Binding CancelCommand}"
                        Style="{StaticResource DangerBtn}"
                        Height="46"/>
            </StackPanel>
        </Grid>

        <!-- PROGRESS -->
        <Grid Grid.Row="4" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ProgressBar Height="6" Minimum="0" Maximum="100"
                         Value="{Binding ProgressPercent}"
                         Foreground="{DynamicResource AccentBlue}"
                         Background="{DynamicResource BgTertiary}"/>
            <TextBlock Grid.Column="1" Text="{Binding ProgressText}"
                       FontSize="11" Foreground="{DynamicResource TextSecondary}"
                       VerticalAlignment="Center" Margin="8,0,0,0"/>
        </Grid>

        <!-- RESULTADOS -->
        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="260"/>
            </Grid.ColumnDefinitions>

            <TabControl SelectedIndex="{Binding SelectedTab, Mode=TwoWay}">
                <TabItem Header="📋 Todos">
                    <ListBox ItemsSource="{Binding AllResults}"
                             SelectedItem="{Binding SelectedResult}"
                             Background="{DynamicResource BgSecondary}"
                             BorderThickness="0" FontSize="12"
                             FontFamily="Consolas"
                             HorizontalContentAlignment="Stretch"
                             VirtualizingStackPanel.IsVirtualizing="True"
                             VirtualizingStackPanel.VirtualizationMode="Recycling"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             Padding="4">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="2,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="50"/>
                                        <ColumnDefinition Width="50"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="✅" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Email}"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextPrimary}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Domain}"
                                               Foreground="{DynamicResource TextSecondary}"
                                               FontSize="10"/>
                                    <TextBlock Grid.Column="3" Text="{Binding Score}"
                                               Foreground="{DynamicResource AccentBlue}"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="4">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="{Binding Status}"/>
                                                <Setter Property="Foreground"
                                                        Value="{DynamicResource TextSecondary}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="Valid">
                                                        <Setter Property="Foreground" Value="{DynamicResource AccentGreen}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Invalid">
                                                        <Setter Property="Foreground" Value="{DynamicResource AccentRed}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Risky">
                                                        <Setter Property="Foreground" Value="{DynamicResource AccentOrange}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Disposable">
                                                        <Setter Property="Foreground" Value="{DynamicResource AccentPurple}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </TabItem>

                <TabItem Header="✅ Válidos">
                    <ListBox ItemsSource="{Binding ValidResults}"
                             SelectedItem="{Binding SelectedResult}"
                             Background="{DynamicResource BgSecondary}"
                             BorderThickness="0" FontSize="12"
                             FontFamily="Consolas"
                             HorizontalContentAlignment="Stretch"
                             VirtualizingStackPanel.IsVirtualizing="True"
                             Padding="4">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="2,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="50"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="✅" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Email}"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextPrimary}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Domain}"
                                               Foreground="{DynamicResource TextSecondary}" FontSize="10"/>
                                    <TextBlock Grid.Column="3" Text="{Binding Score}"
                                               Foreground="{DynamicResource AccentBlue}"
                                               HorizontalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </TabItem>

                <TabItem Header="❌ Inválidos">
                    <ListBox ItemsSource="{Binding InvalidResults}"
                             SelectedItem="{Binding SelectedResult}"
                             Background="{DynamicResource BgSecondary}"
                             BorderThickness="0" FontSize="12"
                             FontFamily="Consolas"
                             HorizontalContentAlignment="Stretch"
                             VirtualizingStackPanel.IsVirtualizing="True"
                             Padding="4">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="2,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="❌" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Email}"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextPrimary}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Error}"
                                               Foreground="{DynamicResource AccentRed}"
                                               FontSize="10" TextTrimming="CharacterEllipsis"
                                               MaxWidth="200"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </TabItem>

                <TabItem Header="⚠️ Risky">
                    <ListBox ItemsSource="{Binding RiskyResults}"
                             SelectedItem="{Binding SelectedResult}"
                             Background="{DynamicResource BgSecondary}"
                             BorderThickness="0" FontSize="12"
                             FontFamily="Consolas"
                             HorizontalContentAlignment="Stretch"
                             VirtualizingStackPanel.IsVirtualizing="True"
                             Padding="4">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="2,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="⚠️" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Email}"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextPrimary}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Reason}"
                                               Foreground="{DynamicResource AccentOrange}" FontSize="10"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </TabItem>

                <TabItem Header="🗑️ Desechables">
                    <ListBox ItemsSource="{Binding DisposableResults}"
                             SelectedItem="{Binding SelectedResult}"
                             Background="{DynamicResource BgSecondary}"
                             BorderThickness="0" FontSize="12"
                             FontFamily="Consolas"
                             HorizontalContentAlignment="Stretch"
                             VirtualizingStackPanel.IsVirtualizing="True"
                             Padding="4">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="2,3">
                                    <TextBlock Text="🗑️" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Email}"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextPrimary}"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </TabItem>

                <TabItem Header="🚫 Bloqueados">
                    <ListBox ItemsSource="{Binding BlockedResults}"
                             SelectedItem="{Binding SelectedResult}"
                             Background="{DynamicResource BgSecondary}"
                             BorderThickness="0" FontSize="12"
                             FontFamily="Consolas"
                             HorizontalContentAlignment="Stretch"
                             VirtualizingStackPanel.IsVirtualizing="True"
                             Padding="4">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="2,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="🚫" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Email}"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextPrimary}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding SmtpResponse}"
                                               Foreground="#FF7B72" FontSize="10"
                                               TextTrimming="CharacterEllipsis" MaxWidth="250"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </TabItem>
            </TabControl>

            <!-- DETALLE -->
            <Border Grid.Column="1" Background="{DynamicResource BgSecondary}"
                    CornerRadius="8" Padding="12" Margin="8,0,0,0"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="DETALLES" FontSize="13" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentBlue}" Margin="0,0,0,12"/>
                        <TextBlock Text="Email" FontSize="10" Foreground="{DynamicResource TextSecondary}"/>
                        <TextBlock Text="{Binding SelectedResult.Email}" FontSize="12"
                                   Foreground="White" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <TextBlock Text="Estado" FontSize="10" Foreground="{DynamicResource TextSecondary}"/>
                        <TextBlock Text="{Binding SelectedResult.Status}" FontSize="12"
                                   Foreground="White" Margin="0,0,0,8"/>
                        <TextBlock Text="Dominio" FontSize="10" Foreground="{DynamicResource TextSecondary}"/>
                        <TextBlock Text="{Binding SelectedResult.Domain}" FontSize="12"
                                   Foreground="White" Margin="0,0,0,8"/>
                        <TextBlock Text="MX Record" FontSize="10" Foreground="{DynamicResource TextSecondary}"/>
                        <TextBlock Text="{Binding SelectedResult.MxRecord}" FontSize="11"
                                   Foreground="White" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <TextBlock Text="SMTP Response" FontSize="10" Foreground="{DynamicResource TextSecondary}"/>
                        <TextBlock Text="{Binding SelectedResult.SmtpResponse}" FontSize="11"
                                   Foreground="White" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <TextBlock Text="Score" FontSize="10" Foreground="{DynamicResource TextSecondary}"/>
                        <TextBlock Text="{Binding SelectedResult.Score}" FontSize="12"
                                   Foreground="{DynamicResource AccentBlue}" Margin="0,0,0,8"/>
                        <TextBlock Text="Catch-all" FontSize="10" Foreground="{DynamicResource TextSecondary}"/>
                        <TextBlock Text="{Binding SelectedResult.IsCatchAll}" FontSize="12"
                                   Foreground="{DynamicResource AccentOrange}" Margin="0,0,0,8"/>
                        <TextBlock Text="Role" FontSize="10" Foreground="{DynamicResource TextSecondary}"/>
                        <TextBlock Text="{Binding SelectedResult.Role}" FontSize="11"
                                   Foreground="{DynamicResource AccentPurple}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <TextBlock Text="Disposable" FontSize="10" Foreground="{DynamicResource TextSecondary}"/>
                        <TextBlock Text="{Binding SelectedResult.IsDisposable}" FontSize="12"
                                   Foreground="{DynamicResource AccentPurple}" Margin="0,0,0,8"/>
                        <TextBlock Text="Error" FontSize="10" Foreground="{DynamicResource TextSecondary}"/>
                        <TextBlock Text="{Binding SelectedResult.Error}" FontSize="11"
                                   Foreground="{DynamicResource AccentRed}" TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- EXPORTAR -->
        <WrapPanel Grid.Row="6" Margin="0,8,0,0">
            <Button Content="CSV Todos" Command="{Binding ExportCsvCommand}"
                    Style="{StaticResource SecondaryBtn}" Margin="0,0,4,0"/>
            <Button Content="TXT Todos" Command="{Binding ExportTxtCommand}"
                    Style="{StaticResource SecondaryBtn}" Margin="0,0,4,0"/>
            <Button Content="CSV Solo Validos" Command="{Binding ExportValidCsvCommand}"
                    Style="{StaticResource SecondaryBtn}" Margin="0,0,4,0"/>
            <Button Content="TXT Solo Validos" Command="{Binding ExportValidTxtCommand}"
                    Style="{StaticResource SecondaryBtn}" Margin="0,0,4,0"/>
            <Button Content="EXCEL Todos" Command="{Binding ExportExcelCommand}"
                    Style="{StaticResource SecondaryBtn}" Margin="0,0,4,0"
                    Foreground="{DynamicResource AccentGreen}"/>
            <Button Content="EXCEL Solo Validos" Command="{Binding ExportValidExcelCommand}"
                    Style="{StaticResource SecondaryBtn}" Margin="0,0,4,0"
                    Foreground="{DynamicResource AccentGreen}"/>
            <Button Content="Limpiar" Command="{Binding ClearCommand}"
                    Style="{StaticResource DangerBtn}" Margin="0,0,4,0"/>
        </WrapPanel>

    </Grid>
</Window>
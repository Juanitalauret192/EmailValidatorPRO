<Window x:Class="EmailValidatorPRO.LicenseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Activar Licencia - Email Validator PRO"
        Height="520" Width="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#0D1117"
        ShowInTaskbar="False"
        WindowStyle="ToolWindow">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Título -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
            <TextBlock Text="🔑" FontSize="36" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <TextBlock Text="Activar Licencia PRO" FontSize="24" FontWeight="Bold"
                       Foreground="#58A6FF" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Descripción -->
        <TextBlock Grid.Row="1" TextWrapping="Wrap" Foreground="#8B949E" FontSize="13" Margin="0,0,0,16">
            Ingresá tu clave de licencia para desbloquear validación ilimitada.
            Las claves mensuales (EVM) duran 30 días. Las definitivas (EVP) no expiran.
        </TextBlock>

        <!-- Estado actual -->
        <Border Grid.Row="2" Background="#161B22" CornerRadius="8" Padding="12" Margin="0,0,0,12"
                BorderBrush="#30363D" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="Estado actual:" FontSize="11" Foreground="#8B949E" FontWeight="Medium"/>
                <TextBlock x:Name="StatusText" Text="Cargando..." FontSize="14" FontWeight="Bold"
                           Foreground="#C9D1D9" Margin="0,4,0,0"/>
                <TextBlock x:Name="UsageText" Text="" FontSize="11" Foreground="#D29922" Margin="0,2,0,0"/>
                <TextBlock x:Name="ExpirationText" Text="" FontSize="11" Foreground="#DA3633" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <!-- Info de tipos -->
        <Border Grid.Row="3" Background="#161B22" CornerRadius="8" Padding="12" Margin="0,0,0,16"
                BorderBrush="#30363D" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="Tipos de licencia:" FontSize="11" Foreground="#8B949E" FontWeight="Medium" Margin="0,0,0,6"/>
                <TextBlock Text="EVP-XXXX-XXXX-XXXX-XXXX  →  Definitiva (sin vencimiento)" FontSize="11" Foreground="#238636" Margin="0,0,0,2"/>
                <TextBlock Text="EVM-XXXX-XXXX-XXXX-XXXX  →  Mensual (30 días desde activación)" FontSize="11" Foreground="#58A6FF"/>
            </StackPanel>
        </Border>

        <!-- Input de clave -->
        <TextBlock Grid.Row="4" Text="Clave de licencia:" FontSize="12" Foreground="#8B949E" Margin="0,0,0,6"/>
        <TextBox x:Name="KeyInput" Grid.Row="5"
                 FontFamily="Consolas" FontSize="16"
                 CharacterCasing="Upper"
                 Background="#161B22" Foreground="#C9D1D9"
                 BorderBrush="#30363D" BorderThickness="1"
                 Padding="10,8"
                 TextAlignment="Center"
                 MaxLength="24"/>
        <TextBlock Grid.Row="5" Text="EVP-XXXX-XXXX-XXXX-XXXX o EVM-XXXX-XXXX-XXXX-XXXX"
                   FontSize="10" Foreground="#484F58" HorizontalAlignment="Center" Margin="0,32,0,0"/>

        <!-- Resultado -->
        <TextBlock x:Name="ResultMessage" Grid.Row="6"
                   TextWrapping="Wrap" FontSize="12"
                   VerticalAlignment="Bottom" Margin="0,12,0,12"/>

        <!-- Botones -->
        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="❌ Cancelar" Click="Cancel_Click"
                    Width="100" Height="34" Margin="0,0,8,0"
                    Background="#21262D" Foreground="#8B949E"
                    FontSize="12" Cursor="Hand" BorderThickness="1" BorderBrush="#30363D">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="10,6" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#30363D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Button Content="✅ Activar" Click="Activate_Click"
                    Width="100" Height="34"
                    Background="#238636" Foreground="White"
                    FontSize="12" FontWeight="Bold" Cursor="Hand" BorderThickness="0">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="10,6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2EA043"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>
    </Grid>
</Window>
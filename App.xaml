<Application x:Class="EmailValidatorPRO.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- Colores Dark Theme GitHub Style -->
        <SolidColorBrush x:Key="BgPrimary" Color="#0D1117"/>
        <SolidColorBrush x:Key="BgSecondary" Color="#161B22"/>
        <SolidColorBrush x:Key="BgTertiary" Color="#21262D"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#30363D"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#C9D1D9"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#8B949E"/>
        <SolidColorBrush x:Key="AccentGreen" Color="#238636"/>
        <SolidColorBrush x:Key="AccentRed" Color="#DA3633"/>
        <SolidColorBrush x:Key="AccentOrange" Color="#D29922"/>
        <SolidColorBrush x:Key="AccentBlue" Color="#58A6FF"/>
        <SolidColorBrush x:Key="AccentPurple" Color="#BC8CFF"/>
        <SolidColorBrush x:Key="ButtonBg" Color="#21262D"/>
        <SolidColorBrush x:Key="ButtonHover" Color="#30363D"/>
        <SolidColorBrush x:Key="ProgressBarBg" Color="#21262D"/>
        <SolidColorBrush x:Key="ProgressBarFill" Color="#238636"/>
    </Application.Resources>
</Application>
